{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["trigger.ts", "src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts"]
}