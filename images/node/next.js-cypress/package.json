{
  "name": "cefetcodelab-node-nextjs-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js (student) + Cypress (teacher) worker",
  "scripts": {
    "start": "ts-node trigger.ts",
    "build:web": "next build",
    "start:web": "next start -p 3000",
    "cy:run": "cypress run --quiet --headless --browser chrome --reporter json --reporter-options output=cypress-results.json",
    "test": "npm run build:web && start-server-and-test start:web http://127.0.0.1:3000 cy:run"
  },
  "dependencies": {
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "start-server-and-test": "2.0.8",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "ts-node": "^10.9.2"
  }
}
