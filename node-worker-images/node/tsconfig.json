{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@types/babel__core",
      "jest",
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "./*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.js",
  ],
}