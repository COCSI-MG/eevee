REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Minikube workers fetch snapshots using the in-cluster storage Service.
EEVEE_WORKER_STORAGE_URL=http://source-storage.eevee-dev-storage:3020
# Copy the value from platform-api/.env.
EEVEE_STORAGE_SIGNING_SECRET=

# Use the worker images loaded into Minikube by make prepare-workers.
K8S_JOB_IMAGE_PULL_POLICY=IfNotPresent

# The runner uses the active kubeconfig context. Select Minikube before starting.
# KUBECONFIG=C:/Users/your-user/.kube/config
