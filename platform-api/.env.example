ENV=local
PORT=3010

PG_TYPE=postgres
PG_HOST=localhost
PG_PORT=5433
PG_USERNAME=eevee_user
PG_PASSWORD=eevee_password
PG_DATABASE=eevee_db

JWT_SECRET=
# Duração da sessão em segundos (JWT e cookie). Padrão: 43200 (12h).
AUTH_SESSION_TTL_SECONDS=43200

# Match infrastructure/docker-compose.yml when API runs on the host:
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated list of additional allowed CORS origins.
# Example: http://136.248.94.172,http://136.248.94.172:3000
CORS_ALLOWED_ORIGINS=

GROQ_API_KEY=

# Consulte docs/local-development.md#recuperacao-de-senha-e-smtp
GMAIL_USER=
GMAIL_APP_PASSWORD=

FRONT_URL=http://localhost:3000
FRONT_ROUTE_RESET_PASSWORD=/reset-password
