ENV=local
PORT=3010

PG_TYPE=postgres
PG_HOST=localhost
PG_PORT=5433
PG_USERNAME=eevee_user
PG_PASSWORD=eevee_password
PG_DATABASE=eevee_db

JWT_SECRET=
# Duração do token de acesso em segundos (JWT e cookie). Padrão: 900 (15min).
AUTH_SESSION_TTL_SECONDS=900
# Duração do refresh token em segundos. Padrão: 1209600 (14 dias).
AUTH_REFRESH_TTL_SECONDS=1209600
# Janela em que uma rotação repetida é tratada como corrida entre abas. Padrão: 15.
AUTH_ROTATION_GRACE_SECONDS=15
# Dias que o histórico de sessão é mantido após vencer. Padrão: 7.
AUTH_SESSION_HISTORY_DAYS=7
# Agendamento da limpeza de sessões vencidas. Padrão: 0 3 * * * (03:00).
AUTH_SESSION_CLEANUP_CRON=0 3 * * *

# Match infrastructure/docker-compose.yml when API runs on the host:
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated list of additional allowed CORS origins.
# Example: http://136.248.94.172,http://136.248.94.172:3000
CORS_ALLOWED_ORIGINS=

GROQ_API_KEY=

# Consulte docs/local-development.md#recuperacao-de-senha-e-smtp
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional SMTP provider (overrides the Gmail settings above).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=EEVEE <convites@example.com>

FRONT_URL=http://localhost:3000
FRONT_ROUTE_RESET_PASSWORD=/reset-password
